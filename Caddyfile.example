# Caddyfile for the simplest self-host path.
# Caddy auto-issues a Let's Encrypt cert for {$CAIRN_HOSTNAME}, terminates TLS,
# and reverse-proxies to the Cairn container on port 8000. See the commented
# Caddy block at the bottom of docker-compose.yml for how to wire it up.

{$CAIRN_HOSTNAME} {
    encode gzip

    # In oidc mode (CAIRN_AUTH_MODE=oidc) Cairn owns its OWN login: an in-app
    # single sign-on wall in front of every route except /healthz and the login
    # routes. Once you have linked yourself (`cairn users link`) and verified
    # sign-in, NO external auth gate is required — just proxy straight through.
    # Keep the container port reachable only by Caddy (Cairn trusts
    # X-Forwarded-* headers from any peer).
    reverse_proxy cairn:8000

    # ── Access log without the OIDC callback secrets ──
    # The provider redirects to /auth/oidc/callback?code=...&state=...&iss=...
    # Cairn keeps the query out of its own log; if you enable Caddy's access log,
    # strip those parameters from it too (Caddy 2.8+ filter syntax; older
    # releases nest the field under `fields { ... }`):
    # log {
    #     format filter {
    #         wrap json
    #         request>uri query {
    #             delete code
    #             delete state
    #             delete iss
    #             delete session_state
    #         }
    #     }
    # }

    # ── Optional gate for single-user installs ──
    # Single-user mode (CAIRN_AUTH_MODE=single) has no in-app login, so you
    # SHOULD gate the front door (in oidc mode these are optional — keep one
    # during the rollout, then remove it). Uncomment ONE of the blocks below (and remove the
    # bare `reverse_proxy` above — fold it into the chosen block instead).
    #
    # ── Option 1: Caddy basic auth ──
    # Generate hash: docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR_PASSWORD'
    # basic_auth {
    #     youruser $2a$14$REPLACE_WITH_BCRYPT_HASH
    # }
    #
    # ── Option 2: IP allowlist ──
    # @untrusted not remote_ip 1.2.3.4 5.6.7.8/32
    # respond @untrusted "Forbidden" 403

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }
}

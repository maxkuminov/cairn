        <main class="content">
          
<div style="max-width:820px">
  <div class="page-header">
    <div>
      <h1>Verify a proof</h1>
      <div class="page-header__sub">Prove that a file existed in its exact, unaltered form on or before a certain date, in a way anyone can independently check. Pick a file below and Cairn confirms when it was first recorded. The file itself never leaves the server; nothing is uploaded.</div>
    </div>
  </div>

  <div id="verify-pane">
    
      <div class="card card--flush">
        <div style="padding:18px 18px 16px">
          <div class="verify-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
            
            <input type="search" name="q" autofocus value=""
                   aria-label="Search tracked files by file name or path"
                   placeholder="Search 5 tracked files by file name or path…"
                   hx-get="/verify/search" hx-trigger="keyup changed delay:200ms, search"
                   hx-target="#verify-results" hx-swap="outerHTML" />
          </div>
        </div>
        

<div id="verify-results">
  <div style="padding:0 18px 6px;font-size:11px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:var(--text-3)">
    Recent proofs
  </div>
  <div style="max-height:420px;overflow-y:auto;padding-bottom:6px">
    
      <button class="verify-row" type="button"
              hx-post="/verify" hx-vals='{"file_id": 1}' hx-target="#verify-pane" hx-swap="innerHTML">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
        <div style="min-width:0;flex:1">
          <div class="verify-row__name">alpha.txt</div>
          <div class="verify-row__meta mono">fixture · ok/alpha.txt</div>
        </div>
        <span class="pill pill--soft pill--ok pill--sm"><svg width="11.5" height="11.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 7.5h4a2.2 2.2 0 0 1 0 4.5h-4M9.5 12h4.3a2.2 2.2 0 0 1 0 4.5H9.5M9.5 7.5v9M11 6v1.5M11 16.5V18M13 6v1.5M13 16.5V18"/></svg>Anchored</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><path d="m9 6 6 6-6 6"/></svg>
      </button>
    
      <button class="verify-row" type="button"
              hx-post="/verify" hx-vals='{"file_id": 2}' hx-target="#verify-pane" hx-swap="innerHTML">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
        <div style="min-width:0;flex:1">
          <div class="verify-row__name">beta.txt</div>
          <div class="verify-row__meta mono">fixture · ok/beta.txt</div>
        </div>
        <span class="pill pill--soft pill--ok pill--sm"><svg width="11.5" height="11.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 7.5h4a2.2 2.2 0 0 1 0 4.5h-4M9.5 12h4.3a2.2 2.2 0 0 1 0 4.5H9.5M9.5 7.5v9M11 6v1.5M11 16.5V18M13 6v1.5M13 16.5V18"/></svg>Anchored</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><path d="m9 6 6 6-6 6"/></svg>
      </button>
    
      <button class="verify-row" type="button"
              hx-post="/verify" hx-vals='{"file_id": 3}' hx-target="#verify-pane" hx-swap="innerHTML">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
        <div style="min-width:0;flex:1">
          <div class="verify-row__name">gamma.txt</div>
          <div class="verify-row__meta mono">fixture · mod/gamma.txt</div>
        </div>
        <span class="pill pill--soft pill--warn pill--sm"><svg width="11.5" height="11.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Pending confirmation</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><path d="m9 6 6 6-6 6"/></svg>
      </button>
    
    
    
  </div>
</div>
        <div class="info-strip" style="border-radius:0;background:transparent;border-top:1px solid var(--border)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
          <span>Or open any file from a collection and click its <strong class="text-2">proof badge</strong> — in any state — to check it directly.</span>
        </div>
      </div>
    
  </div>

  <details class="card" style="margin-top:18px" open>
    <summary style="cursor:pointer;font-weight:650;font-size:14px;display:flex;align-items:center;gap:8px">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-3"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg> How this works
    </summary>
    <div style="margin-top:14px;display:flex;flex-direction:column;gap:14px">
      <div style="display:flex;gap:12px;align-items:flex-start">
        <span class="verify-step__num">1</span>
        <div>
          <div style="font-weight:650;font-size:13.5px;margin-bottom:2px">A digital fingerprint of the file</div>
          <div class="text-2" style="font-size:13px;line-height:1.55">When Cairn first sees a file, it calculates a <strong>hash</strong> (technically a “SHA-256”): a short, unique fingerprint computed from the file's exact contents. Change a single comma and the fingerprint changes completely, so it can prove a file hasn't been altered. The fingerprint can't be turned back into the file, so it reveals nothing about what's inside.</div>
        </div>
      </div>
      <div style="display:flex;gap:12px;align-items:flex-start">
        <span class="verify-step__num">2</span>
        <div>
          <div style="font-weight:650;font-size:13.5px;margin-bottom:2px">Recorded permanently on Bitcoin</div>
          <div class="text-2" style="font-size:13px;line-height:1.55">That fingerprint is written into the <strong>Bitcoin blockchain</strong>, a public, worldwide ledger that is permanent and cannot be backdated or quietly edited. Cairn does this using <strong>OpenTimestamps</strong>, a free and open standard for timestamping. Only the fingerprint is published, never the file.</div>
        </div>
      </div>
      <div style="display:flex;gap:12px;align-items:flex-start">
        <span class="verify-step__num">3</span>
        <div>
          <div style="font-weight:650;font-size:13.5px;margin-bottom:2px">Anyone can check it, without trusting Cairn</div>
          <div class="text-2" style="font-size:13px;line-height:1.55">Because the record is public, you, or an auditor, lawyer, or client, can confirm the file existed in this exact form by a given date, using the file plus its small proof file. The guarantee rests on Bitcoin and math, not on Cairn or any single company staying online.</div>
        </div>
      </div>
      <a class="btn btn--ghost btn--sm" href="/learn" style="align-self:flex-start"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg> Read the full primer</a>
    </div>
  </details>
</div>

        </main>
      </div>
    </div>
    
    
<script>
  (function () {
    // Hidden-textarea + execCommand: the pre-async-clipboard path, still the only one that works
    // on an insecure origin. Also the fallback when a secure-context write is rejected (permission
    // policy, a document that isn't focused).
    function legacyCopy(text) {
      try {
        var ta = document.createElement("textarea");
        ta.value = text;
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.top = "-1000px";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        ta.setSelectionRange(0, ta.value.length);
        var ok = document.execCommand("copy");
        document.body.removeChild(ta);
        return !!ok;
      } catch (e) {
        return false;
      }
    }

    // The visible outcome. `note` is an element or the id of one; a caller with nowhere to report
    // to still gets the copy attempted.
    window.cairnCopyReport = function (note, ok) {
      if (typeof note === "string") { note = document.getElementById(note); }
      if (!note) return;
      note.textContent = ok ? "Copied ✓" : "Couldn't copy — select the text and copy it manually";
      note.style.color = ok ? "" : "var(--danger)";
      note.hidden = false;
      setTimeout(function () { note.hidden = true; }, ok ? 1800 : 5000);
    };

    window.cairnCopy = function (text, note) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function () {
          window.cairnCopyReport(note, true);
        }).catch(function () {
          window.cairnCopyReport(note, legacyCopy(text));
        });
      } else {
        window.cairnCopyReport(note, legacyCopy(text));
      }
    };
  })();
</script>
    <script>
      // Mobile nav drawer: the hamburger toggles `body.nav-open`; the backdrop and any sidebar
      // link close it. No-op on desktop (the drawer styles only apply under the breakpoint).
      (function () {
        var body = document.body;
        var close = function () { body.classList.remove("nav-open"); };
        var toggle = document.getElementById("nav-toggle");
        if (toggle) {
          toggle.addEventListener("click", function () { body.classList.toggle("nav-open"); });
        }
        var backdrop = document.getElementById("nav-backdrop");
        if (backdrop) { backdrop.addEventListener("click", close); }
        document.querySelectorAll(".sidebar a").forEach(function (a) {
          a.addEventListener("click", close);
        });
      })();
    </script>
  </body>
</html>
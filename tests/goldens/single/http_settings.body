        <main class="content">
          
<div style="max-width:820px">
  <div class="page-header">
    <div>
      <h1>Settings</h1>
      <div class="page-header__sub">Your notification channels and verification backend.</div>
    </div>
  </div>

  <div class="tabs">
    <a class="tab is-active" href="/settings?tab=notifications"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg> Notifications</a>
    <a class="tab " href="/settings?tab=verify"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6l7-3z"/><path d="M9 11.5l2 2 4-4"/></svg> Verification</a>
    
  </div>

  
    <div class="settings-stack">
      
      <div>
        <div class="section-label">Panel address</div>
        <div class="card" style="margin-top:12px;padding:20px">
          <div class="channel-head" style="margin-bottom:14px">
            <div class="icon-tile icon-tile--muted"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 15l6-6"/><path d="M11 6l1-1a4 4 0 0 1 6 6l-1 1M13 18l-1 1a4 4 0 0 1-6-6l1-1"/></svg></div>
            <div class="channel-head__body">
              <div class="channel-title-row">
                <span class="channel-title">Panel address</span>
                
                  <span class="pill pill--soft pill--muted pill--sm">Not set</span>
                
              </div>
              <div class="channel-sub">The address alert links point at — use the one a person actually reaches in a browser (your reverse proxy), not the container's bind address. Leave it blank and alerts are sent without a link.</div>
            </div>
          </div>

          
          
          

          
            <form method="post" action="/settings/panel-url" class="form-stack" style="gap:14px">
              <input type="hidden" name="csrf_token" value="<CSRF>" />
              <label class="field">
                <div class="field__label-row"><span class="field__label">Panel address</span></div>
                <input class="input" name="public_url" type="text" value="" placeholder="https://cairn.example.com" />
                <div class="field__hint">http:// or https://, host, optional port and path prefix — no query string or fragment. A LAN address such as <span class="mono">http://192.168.1.10:8000</span> is fine if that is what you open. Clear the field to fall back to <span class="mono">CAIRN_PUBLIC_URL</span>.</div>
                
                  <div class="field__hint">Nothing is set here or in <span class="mono">CAIRN_PUBLIC_URL</span>, so alerts are sent without a link.</div>
                
              </label>
              <div class="flex" style="gap:10px">
                <button type="submit" class="btn btn--primary">Save panel address</button>
              </div>
            </form>
          
        </div>
      </div>

      
      <div>
        <div class="section-label">Alert channel</div>
        <div class="card" style="margin-top:12px;padding:20px">
          <div class="channel-head" style="margin-bottom:16px">
            <div class="icon-tile icon-tile--accent"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></div>
            <div class="channel-head__body">
              <div class="channel-title-row">
                <span class="channel-title">Email</span>
                <span class="pill pill--soft pill--ok pill--sm"><svg width="11.5" height="11.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>Verified</span>
              </div>
              <div class="channel-sub">The SMTP server Cairn sends alert mail through. Per-collection recipients are set on each collection.</div>
            </div>
            <button type="button" class="toggle is-on" aria-label="Email enabled"><span class="toggle__knob"></span></button>
          </div>
          <div>
            <div style="font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:8px">Provider</div>
            <div class="seg seg--equal" id="provider-seg" style="margin-bottom:14px">
                <button type="button" class="seg__btn is-active" data-prov="smtp" onclick="cairnSetProvider('smtp')">Local SMTP</button>
              
                <button type="button" class="seg__btn " data-prov="resend" onclick="cairnSetProvider('resend')">Resend</button>
              
                <button type="button" class="seg__btn " data-prov="ses" onclick="cairnSetProvider('ses')">AWS SES</button>
              
            </div>

            
            

            
            <div id="provider-smtp" data-prov-panel="smtp">
              
                <form method="post" action="/settings/smtp" class="form-stack" style="gap:14px">
                  <input type="hidden" name="csrf_token" value="<CSRF>" />
                  <div class="form-grid-2">
                    <label class="field">
                      <div class="field__label-row"><span class="field__label">Host</span></div>
                      <input class="input" name="smtp_host" type="text" value="" placeholder="smtp.example.com" />
                    </label>
                    <label class="field">
                      <div class="field__label-row"><span class="field__label">Port</span></div>
                      <input class="input" name="smtp_port" type="number" min="1" max="65535" value="587" placeholder="587" />
                    </label>
                  </div>
                  <label class="field">
                    <div class="field__label-row"><span class="field__label">Encryption</span></div>
                    <select class="input" name="smtp_encryption">
                      <option value="starttls" selected>STARTTLS</option>
                      <option value="none" >None</option>
                    </select>
                  </label>
                  <div class="form-grid-2">
                    <label class="field">
                      <div class="field__label-row"><span class="field__label">Username</span></div>
                      <input class="input" name="smtp_user" type="text" autocomplete="off" value="" placeholder="cairn@example.com" />
                    </label>
                    <label class="field">
                      <div class="field__label-row"><span class="field__label">Password</span></div>
                      <input class="input" name="smtp_password" type="password" autocomplete="new-password"
                             placeholder="set a password" />
                      <div class="field__hint">Stored in the local database. Leave blank to keep the current password.</div>
                    </label>
                  </div>
                  <label class="field">
                    <div class="field__label-row"><span class="field__label">From address</span></div>
                    <input class="input" name="smtp_from" type="text" value="" placeholder="cairn@example.com" />
                  </label>
                  <div class="flex" style="gap:10px">
                    <button type="submit" class="btn btn--primary">Save SMTP settings</button>
                  </div>
                </form>

                <form method="post" action="/settings/smtp/test" class="flex-center" style="gap:10px;margin-top:16px;padding-top:16px;border-top:1px solid var(--border)">
                  <input type="hidden" name="csrf_token" value="<CSRF>" />
                  <input class="input" name="test_to" type="text" style="flex:1" placeholder="you@example.com" />
                  <button type="submit" class="btn">Send test email</button>
                </form>
                <div class="field__hint" style="margin-top:8px">Sends a one-off test message with the saved settings above.</div>
              
            </div>

            <div id="provider-resend" data-prov-panel="resend" style="display:none">
              <div class="config-preview">
                <div class="config-row"><span class="config-row__key">API key</span><span class="config-row__val mono">re_••••••••••3f9a</span></div>
                <div class="config-row"><span class="config-row__key">From</span><span class="config-row__val mono">alerts@example.com</span></div>
              </div>
              <div style="font-size:12px;color:var(--text-3);margin-top:10px">Resend transport is recognized but not yet wired — alerts are sent via Local SMTP.</div>
            </div>

            <div id="provider-ses" data-prov-panel="ses" style="display:none">
              <div class="config-preview">
                <div class="config-row"><span class="config-row__key">Region</span><span class="config-row__val mono">us-east-1</span></div>
                <div class="config-row"><span class="config-row__key">From</span><span class="config-row__val mono">alerts@example.com</span></div>
              </div>
              <div style="font-size:12px;color:var(--text-3);margin-top:10px">AWS SES transport is recognized but not yet wired — alerts are sent via Local SMTP.</div>
            </div>
          </div>
        </div>
      </div>

      
      <div>
        <div class="section-label">Health monitoring</div>
        <div class="card" style="margin-top:12px;padding:18px">
          <div class="channel-head">
            <div class="icon-tile icon-tile--ok"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l2.5-7 4 14L15 12h7"/></svg></div>
            <div class="channel-head__body">
              
              <div class="channel-title-row">
                <span class="channel-title">Health endpoint</span>
              </div>
              <div class="channel-sub">Point Uptime Kuma or any monitor at this URL — it returns scan freshness as a dead-man's switch.</div>
            </div>
          </div>
          <div class="mono-row" style="margin-top:13px">
            <span style="color:var(--ok);font-weight:600">GET</span>
            <span class="text-2" id="healthz-url">https://cairn.example.com/healthz</span>
            <span class="pill pill--soft pill--muted pill--sm">Example</span>
            
            <button type="button" class="copy-btn" style="margin-left:auto" aria-label="Copy health URL"
                    onclick="cairnCopy(document.getElementById('healthz-url').textContent.trim(), 'healthz-url-copied')"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/></svg></button>
          </div>
          <div class="copy-note" id="healthz-url-copied" hidden></div>
          
            <div class="field__hint" style="margin-top:10px">That is an illustrative address, not yours — set the panel address above and this becomes your real health URL.</div>
          
        </div>
      </div>

      
      <div>
        <div class="section-label">Planned channels</div>
        <div style="display:flex;flex-direction:column;gap:10px;margin-top:12px">
          
            <div class="planned-card">
              <div class="icon-tile icon-tile--muted"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7a4 4 0 1 1 5 4l-2.5 4.5"/><path d="M7.5 11.5 5 16a4 4 0 1 0 4 4h5"/><path d="M16 11a4 4 0 1 1 2 7h-2"/></svg></div>
              <div class="planned-card__body">
                <div style="font-size:14px;font-weight:600">Webhook</div>
                <div class="channel-sub">POST a JSON payload to a URL of your choosing.</div>
              </div>
              <span class="pill pill--soft pill--muted pill--sm">Planned</span>
            </div>
          
            <div class="planned-card">
              <div class="icon-tile icon-tile--muted"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a8 8 0 0 1 16 0M7 12a5 5 0 0 1 10 0M12 18.5a2 2 0 0 0 2-2 2 2 0 0 0-4 0 2 2 0 0 0 2 2z"/></svg></div>
              <div class="planned-card__body">
                <div style="font-size:14px;font-weight:600">Telegram</div>
                <div class="channel-sub">Push to a Telegram chat via a bot token.</div>
              </div>
              <span class="pill pill--soft pill--muted pill--sm">Planned</span>
            </div>
          
            <div class="planned-card">
              <div class="icon-tile icon-tile--muted"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a8 8 0 0 1 16 0M7 12a5 5 0 0 1 10 0M12 18.5a2 2 0 0 0 2-2 2 2 0 0 0-4 0 2 2 0 0 0 2 2z"/></svg></div>
              <div class="planned-card__body">
                <div style="font-size:14px;font-weight:600">Signal</div>
                <div class="channel-sub">Push to your Signal number via a relay.</div>
              </div>
              <span class="pill pill--soft pill--muted pill--sm">Planned</span>
            </div>
          
        </div>
      </div>
    </div>

    <script>
      function cairnSetProvider(k) {
        document.querySelectorAll("[data-prov-panel]").forEach(function (p) {
          p.style.display = p.getAttribute("data-prov-panel") === k ? "" : "none";
        });
        document.querySelectorAll("#provider-seg .seg__btn").forEach(function (b) {
          b.classList.toggle("is-active", b.getAttribute("data-prov") === k);
        });
      }
      cairnSetProvider("smtp");
    </script>

  
</div>

        </main>
      </div>
    </div>
    
    
<script>
  (function () {
    // Hidden-textarea + execCommand: the pre-async-clipboard path, still the only one that works
    // on an insecure origin. Also the fallback when a secure-context write is rejected (permission
    // policy, a document that isn't focused).
    function legacyCopy(text) {
      try {
        var ta = document.createElement("textarea");
        ta.value = text;
        ta.setAttribute("readonly", "");
        ta.style.position = "fixed";
        ta.style.top = "-1000px";
        ta.style.opacity = "0";
        document.body.appendChild(ta);
        ta.select();
        ta.setSelectionRange(0, ta.value.length);
        var ok = document.execCommand("copy");
        document.body.removeChild(ta);
        return !!ok;
      } catch (e) {
        return false;
      }
    }

    // The visible outcome. `note` is an element or the id of one; a caller with nowhere to report
    // to still gets the copy attempted.
    window.cairnCopyReport = function (note, ok) {
      if (typeof note === "string") { note = document.getElementById(note); }
      if (!note) return;
      note.textContent = ok ? "Copied ✓" : "Couldn't copy — select the text and copy it manually";
      note.style.color = ok ? "" : "var(--danger)";
      note.hidden = false;
      setTimeout(function () { note.hidden = true; }, ok ? 1800 : 5000);
    };

    window.cairnCopy = function (text, note) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(function () {
          window.cairnCopyReport(note, true);
        }).catch(function () {
          window.cairnCopyReport(note, legacyCopy(text));
        });
      } else {
        window.cairnCopyReport(note, legacyCopy(text));
      }
    };
  })();
</script>
    <script>
      // Mobile nav drawer: the hamburger toggles `body.nav-open`; the backdrop and any sidebar
      // link close it. No-op on desktop (the drawer styles only apply under the breakpoint).
      (function () {
        var body = document.body;
        var close = function () { body.classList.remove("nav-open"); };
        var toggle = document.getElementById("nav-toggle");
        if (toggle) {
          toggle.addEventListener("click", function () { body.classList.toggle("nav-open"); });
        }
        var backdrop = document.getElementById("nav-backdrop");
        if (backdrop) { backdrop.addEventListener("click", close); }
        document.querySelectorAll(".sidebar a").forEach(function (a) {
          a.addEventListener("click", close);
        });
      })();
    </script>
  </body>
</html>